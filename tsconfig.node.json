{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    // 2026-10：node 侧的测试（tests/storeFlow.test.ts）会 import 渲染层 store，
    // 而 store 动态 import 了 `.tsx` 组件（材质球，three.js），故这里也要能解析 JSX/DOM
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "include": ["electron.vite.config.ts", "vitest.config.ts", "src/main/**/*", "src/shared/**/*", "tests/**/*"]
}
